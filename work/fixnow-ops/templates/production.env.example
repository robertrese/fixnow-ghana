HOST=127.0.0.1
PORT=4180
APP_ENV=production
PUBLIC_ORIGIN=https://app.fixnowghana.org
REQUIRE_HTTPS=1
TRUST_PROXY=1

BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
PASSWORD_PEPPER=replace-with-a-long-random-secret-not-stored-in-the-database
ATTACHMENT_SIGNING_SECRET=replace-with-a-separate-long-random-secret
SEED_DEMO_ACCOUNTS=0

DATA_DIR=/var/lib/fixnow-backend
DB_FILE=/var/lib/fixnow-backend/fixnow.sqlite
SESSION_TTL_HOURS=12
BODY_LIMIT_BYTES=2000000
PUBLIC_REPORT_LIMIT_PER_HOUR=5

UPLOAD_SCAN_WEBHOOK_URL=https://scanner.example.internal/v1/jobs
UPLOAD_SCAN_AUTH_TOKEN=replace-from-secret-manager
MONITORING_WEBHOOK_URL=https://monitoring.example.internal/v1/events
MONITORING_AUTH_TOKEN=replace-from-secret-manager

DATABASE_URL=postgresql://fixnow_api:replace-from-secret-manager@postgis.internal/fixnow?sslmode=verify-full
OBJECT_STORAGE_ENDPOINT=https://objects.example.internal
OBJECT_STORAGE_REGION=af-south-1
OBJECT_STORAGE_BUCKET=fixnow-private-evidence
OBJECT_STORAGE_ACCESS_KEY_ID=replace-from-secret-manager
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-from-secret-manager

SCRYPT_N=131072
SCRYPT_R=8
SCRYPT_P=1
SCRYPT_MAXMEM=268435456
