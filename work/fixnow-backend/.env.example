PORT=4180
HOST=127.0.0.1
APP_ENV=development
PUBLIC_ORIGIN=https://app.fixnowghana.org
REQUIRE_HTTPS=1
TRUST_PROXY=1

# Google Maps Platform: never reuse these across browser, server, or native apps.
# Restrict the browser key by approved HTTPS referrers and to Maps JavaScript API + Places API (New).
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAP_ID=
# Keep server geocoding credentials private and IP-restricted. The current development adapter does not consume it.
GOOGLE_MAPS_SERVER_GEOCODING_KEY=
# Reserve separate keys for native SDK builds; do not place them in web runtime configuration.
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=

# Optional citizen accounts. OTP remains honestly unavailable until this HTTPS provider webhook is configured.
# The provider must accept a private JSON request containing: to, template, purpose, code, expiry and message.
OTP_PROVIDER_WEBHOOK_URL=
OTP_PROVIDER_AUTH_TOKEN=
OTP_HASH_SECRET=replace-with-a-separate-long-random-secret
OTP_EXPIRY_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
CITIZEN_SESSION_TTL_HOURS=24
TERMS_VERSION=2026-08-10
PRIVACY_VERSION=2026-08-10

# Reserved owner credentials. The app keeps these providers disabled until server-side token verification is implemented.
GOOGLE_IDENTITY_CLIENT_ID=
APPLE_SERVICE_ID=

# Store this in a secret manager or protected environment file.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
PASSWORD_PEPPER=replace-with-a-long-random-secret-not-in-the-database
ATTACHMENT_SIGNING_SECRET=replace-with-a-separate-long-random-secret

# Turn this off in production so demo credentials are never created.
SEED_DEMO_ACCOUNTS=0

DATA_DIR=/var/lib/fixnow-backend
DB_FILE=/var/lib/fixnow-backend/fixnow.sqlite
# Pilot target; leave unset while using the local SQLite development adapter.
# DATABASE_URL=postgresql://fixnow_api:secret@db.example.internal/fixnow?sslmode=require
SESSION_TTL_HOURS=12
BODY_LIMIT_BYTES=2000000
PUBLIC_REPORT_LIMIT_PER_HOUR=5

# Optional private scanning and monitoring hooks. Production URLs must use HTTPS.
UPLOAD_SCAN_WEBHOOK_URL=
UPLOAD_SCAN_AUTH_TOKEN=
MONITORING_WEBHOOK_URL=
MONITORING_AUTH_TOKEN=

# Production object storage adapter contract. The local pilot stores private files under DATA_DIR.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=fixnow-private-evidence
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# OWASP recommends scrypt when Argon2id is unavailable.
SCRYPT_N=131072
SCRYPT_R=8
SCRYPT_P=1
SCRYPT_MAXMEM=268435456

# Optional direct HTTPS from Node. Usually Nginx handles TLS instead.
# TLS_KEY_PATH=/etc/letsencrypt/live/api.fixnowghana.org/privkey.pem
# TLS_CERT_PATH=/etc/letsencrypt/live/api.fixnowghana.org/fullchain.pem
